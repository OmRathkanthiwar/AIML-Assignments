# ---------------- EXECUTE QUERY ----------------

def executeQuery(query):

    try:

        result = eval(query)

        if isinstance(result, float):
            return str(round(result,2))

        if hasattr(result,"to_string"):
            return result.to_string()

        return str(result)

    except Exception as e:

        return "Query Error : " + str(e)

