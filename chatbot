def detectIntent(question):

    prompt = f"""
You are an AI classifier.

Your job is to classify the user's question into ONLY ONE of the following:

DATASET
MEDICAL

Return ONLY ONE WORD.

Examples

Question: How many patients are there?
Answer: DATASET

Question: Show all patients above 60 years.
Answer: DATASET

Question: Average cholesterol of females.
Answer: DATASET

Question: Which patient has highest blood pressure?
Answer: DATASET

Question: Explain cholesterol.
Answer: MEDICAL

Question: What causes heart disease?
Answer: MEDICAL

Question: What are symptoms of heart attack?
Answer: MEDICAL

Question:
{question}
"""

    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt
    )

    return response.text.strip().upper()

