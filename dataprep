import os
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.model_selection import KFold
from sklearn.model_selection import LeaveOneOut


BASE_DIR = os.path.dirname(os.path.abspath(__file__))


df = pd.read_csv(
    os.path.join(BASE_DIR, "heart.csv")
)


print("==============================================")
print("        DATA PREPARATION - HEART DATASET")
print("==============================================")


# --------------------------------------------------
# a) FIND SHAPE OF DATA
# --------------------------------------------------

print("\na) Shape of Data")
print("----------------------------------------------")

print("Rows    :", df.shape[0])
print("Columns :", df.shape[1])
print("Shape   :", df.shape)


# --------------------------------------------------
# b) FIND MISSING VALUES
# --------------------------------------------------

print("\nb) Missing Values")
print("----------------------------------------------")

print(df.isnull().sum())


# --------------------------------------------------
# c) FIND DATA TYPE OF EACH COLUMN
# --------------------------------------------------

print("\nc) Data Type of Each Column")
print("----------------------------------------------")

print(df.dtypes)


# --------------------------------------------------
# d) FINDING OUT ZEROS
# --------------------------------------------------

print("\nd) Number of Zeros in Each Column")
print("----------------------------------------------")

zeroValues = (df == 0).sum()

print(zeroValues)


# --------------------------------------------------
# e) FIND MEAN AGE OF PATIENTS
# --------------------------------------------------

print("\ne) Mean Age of Patients")
print("----------------------------------------------")

meanAge = df["age"].mean()

print("Mean Age :", round(meanAge, 2))


# --------------------------------------------------
# f) EXTRACT REQUIRED COLUMNS
# --------------------------------------------------

print("\nf) Selected Columns")
print("----------------------------------------------")

selectedData = df[
    ["age", "sex", "cp", "trestbps", "chol"]
]

print(selectedData)


# --------------------------------------------------
# DIVIDE DATASET INTO TRAINING AND TESTING
# 75% TRAINING
# 25% TESTING
# --------------------------------------------------

trainData, testData = train_test_split(
    selectedData,
    test_size=0.25,
    random_state=42
)


# --------------------------------------------------
# DISPLAY TRAINING DATA
# --------------------------------------------------

print("\n==============================================")
print("TRAINING DATA - 75%")
print("==============================================")

print(trainData)

print("\nTraining Data Shape :", trainData.shape)


# --------------------------------------------------
# DISPLAY TESTING DATA
# --------------------------------------------------

print("\n==============================================")
print("TESTING DATA - 25%")
print("==============================================")

print(testData)

print("\nTesting Data Shape :", testData.shape)


# --------------------------------------------------
# FINAL SUMMARY
# --------------------------------------------------

print("\n==============================================")
print("             FINAL SUMMARY")
print("==============================================")

print("Original Dataset Shape :", df.shape)

print("Selected Data Shape    :", selectedData.shape)

print("Training Data Shape    :", trainData.shape)

print("Testing Data Shape     :", testData.shape)

print("Mean Age               :", round(meanAge, 2))

print("==============================================")

# --------------------------------------------------
# K-FOLD CROSS VALIDATION
# --------------------------------------------------

print("\n==============================================")
print("K-FOLD CROSS VALIDATION")
print("==============================================")

k = 5

kf = KFold(
    n_splits=k,
    shuffle=True,
    random_state=42
)

fold = 1

with open(
    os.path.join(BASE_DIR, "kfold_output.txt"),
    "w"
) as file:

    file.write("K-FOLD CROSS VALIDATION\n")
    file.write("========================\n\n")

    for trainIndex, testIndex in kf.split(selectedData):

        trainFold = selectedData.iloc[trainIndex]
        testFold = selectedData.iloc[testIndex]

        print("\nFold", fold)
        print("Training Data Shape :", trainFold.shape)
        print("Testing Data Shape  :", testFold.shape)

        file.write("Fold " + str(fold) + "\n")
        file.write("------------------------\n")

        file.write(
            "Training Data Shape : "
            + str(trainFold.shape)
            + "\n"
        )

        file.write(
            "Testing Data Shape  : "
            + str(testFold.shape)
            + "\n\n"
        )

        file.write("Training Data:\n")
        file.write(trainFold.to_string())
        file.write("\n\n")

        file.write("Testing Data:\n")
        file.write(testFold.to_string())
        file.write("\n\n")

        fold = fold + 1

print("\nK-Fold output saved in kfold_output.txt")
# --------------------------------------------------
# LEAVE ONE OUT CROSS VALIDATION
# --------------------------------------------------

print("\n==============================================")
print("LEAVE ONE OUT CROSS VALIDATION")
print("==============================================")

loo = LeaveOneOut()

count = 1

with open(
    os.path.join(BASE_DIR, "loo_output.txt"),
    "w"
) as file:

    file.write("LEAVE ONE OUT CROSS VALIDATION\n")
    file.write("===============================\n\n")

    for trainIndex, testIndex in loo.split(selectedData):

        looTrainData = selectedData.iloc[trainIndex]
        looTestData = selectedData.iloc[testIndex]

        # Display first 5 iterations on terminal
        if count <= 5:

            print("\nIteration", count)

            print(
                "Training Data Shape :",
                looTrainData.shape
            )

            print(
                "Testing Data Shape  :",
                looTestData.shape
            )

        # Save every iteration in file
        file.write(
            "Iteration " + str(count) + "\n"
        )

        file.write(
            "Training Data Size : "
            + str(len(looTrainData))
            + "\n"
        )

        file.write(
            "Testing Data Size : "
            + str(len(looTestData))
            + "\n"
        )

        file.write("Testing Data:\n")
        file.write(looTestData.to_string())
        file.write("\n\n")

        count = count + 1


file.write(
    "Total LOO Iterations : "
    + str(count - 1)
)

print("\nTotal LOO Iterations :", count - 1)

print("\nLOO output saved in loo_output.txt")
